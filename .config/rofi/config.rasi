/*
 * fib.rasi
 * Monochrome rofi theme derived from a dwm + st desktop:
 * near-black translucent panes, 2px light-grey square borders,
 * warm grey selection block (matches the active tag / title in the bar).
 *
 * Install: ~/.config/rofi/themes/fib.rasi
 * Use:     rofi -show drun -theme fib
 */

configuration {
    modi:             "drun,run,window";
    show-icons:       false;
    display-drun:     "[mcmk@archlinux ~]$";
    display-run:      "[mcmk@archlinux ~]$";
    display-window:   "[win]$";
    drun-display-format: "{name}";
    sidebar-mode:     false;
}

* {
    font:             "Liberation Mono 11";

    bg:               #0a0a0aE6;
    bg-solid:         #0a0a0a;
    bg-alt:           #1a1a1a;
    fg:               #d6d6d6;
    fg-dim:           #6e6e6e;
    accent:           #bdb9b2;
    border-active:    #dcdcdc;
    border-inactive:  #3a3a3a;

    background-color: transparent;
    text-color:       @fg;
    border-color:     @border-active;
    margin:           0;
    padding:          0;
    spacing:          0;
}

window {
    location:         center;
    anchor:           center;
    width:            640px;
    background-color: @bg;
    border:           2px solid;
    border-color:     @border-active;
    border-radius:    0;
}

mainbox {
    children:         [ inputbar, message, listview ];
    padding:          8px;
    spacing:          8px;
    background-color: transparent;
}

inputbar {
    children:         [ prompt, entry ];
    padding:          4px 6px;
    spacing:          8px;
    background-color: transparent;
    border:           0 0 1px 0;
    border-color:     @border-inactive;
}

prompt {
    text-color:       @accent;
}

entry {
    placeholder:      "";
    placeholder-color: @fg-dim;
    text-color:       @fg;
}

message {
    padding:          4px 6px;
    background-color: @bg-alt;
    border:           1px solid;
    border-color:     @border-inactive;
}

textbox {
    text-color:       @fg-dim;
}

listview {
    lines:            10;
    columns:          1;
    fixed-height:     true;
    scrollbar:        false;
    spacing:          0;
    background-color: transparent;
}

element {
    padding:          4px 8px;
    background-color: transparent;
    text-color:       @fg;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    highlight:        underline;
}

element normal.normal,
element alternate.normal {
    background-color: transparent;
    text-color:       @fg;
}

element normal.urgent,
element alternate.urgent {
    text-color:       @border-active;
}

element normal.active,
element alternate.active {
    text-color:       @accent;
}

element selected.normal,
element selected.urgent,
element selected.active {
    background-color: @accent;
    text-color:       @bg-solid;
}

scrollbar {
    width:            2px;
    handle-width:     2px;
    handle-color:     @accent;
    background-color: @border-inactive;
}

mode-switcher {
    enabled:          false;
}
